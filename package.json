{
  "name": "@yakovlev-i-a/dsh-openfoam-workbench",
  "version": "0.9.39",
  "private": true,
  "type": "module",
  "description": "OpenFOAM workbench for DeepSeek Harness: 69 tools (env, solvers, meshing, multi-region runs, renders, papers, experience) and 12 on-demand CFD skills.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "client.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CORE.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  }
}
