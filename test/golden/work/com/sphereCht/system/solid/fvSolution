FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


solvers
{
    "(h|e)" { solver PCG; preconditioner DIC; tolerance 1e-6; relTol 0.1; }
    "(h|e)Final" { solver PCG; preconditioner DIC; tolerance 1e-6; relTol 0; }
}
PIMPLE { nNonOrthogonalCorrectors 1; nOuterCorrectors 1; }
